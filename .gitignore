# ==============================================================================
# Student Management Portal (SMP) - Root .gitignore
# ==============================================================================

# OS & Workspace
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDEs & Editors
.idea/
*.iml
*.iws
*.ipr
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/
.project
.classpath
.settings/

# Java & Spring Boot (Backend)
**/target/
**/.mvn/wrapper/maven-wrapper.jar
**/*.class
**/*.jar
**/*.war
**/HELP.md
**/hs_err_pid*

# Node & Angular (Frontend)
**/node_modules/
**/dist/
**/.angular/
**/.angular/cache/
**/.sass-cache/
**/coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Database & Runtime Data
**/smp_pgdata/
**/pgdata/
**/*.log
**/*.pid

# Local Environment Variables & Secrets
.env
.env.local
*.pem
*.key
